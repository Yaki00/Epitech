# =============================================================================
# Lyra : configuration du backend
# Copier ce fichier en backend/.env (jamais versionné) et remplir les valeurs entre < >.
# Chemins relatifs = par rapport au dossier backend/. Sous Windows, un chemin absolu s'écrit
# tel quel : C:\Users\moi\lyra\export
# Vérifier ensuite avec : npm run doctor
# =============================================================================

# --- Serveur web ---
PORT=3002
# 127.0.0.1 = accessible seulement depuis ce poste ; 0.0.0.0 sur un serveur partagé
HOST=127.0.0.1
# Données du graphe (fichiers JSON, reconstruits par les synchros : ce dossier peut être supprimé)
DATA_DIR=./data/store
# Interface compilée (npm run build sur une machine Node >= 22.12, puis copier frontend/dist)
FRONTEND_DIST=../frontend/dist
# debug | info | warn | error
LOG_LEVEL=info
# Origine autorisée pour l'interface en développement (Vite)
CORS_ORIGIN=http://localhost:3000

# Consignes de lecture pour l'IA (conventions de nommage, vocabulaire, pages à ignorer) ; facultatif
# CONSIGNES_FILE=./config/consignes-ia.md

# --- IA : passerelle interne compatible OpenAI ---
# URL de base SANS /chat/completions, ex : https://<passerelle-ia>/v1/openai
LLM_BASE_URL=https://<passerelle-ia>/v1/openai
LLM_TOKEN=<jeton de la passerelle IA>
# Un modèle par tâche : noms EXACTS tels que listés par GET <LLM_BASE_URL>/models (npm run doctor les affiche)
LLM_MODEL_EXTRACT=qwen3.6-35b-a3b
LLM_MODEL_CHAT=qwen3.8-27b
LLM_MODEL_SUMMARY=qwen3.8-27b
LLM_MODEL_VISION=<modèle multimodal, ex : gemma-4-31b>
LLM_MODEL_OCR=<modèle OCR, ex : mistral-ocr-4>
LLM_MODEL_EMBED=qwen3-embedding-8b
LLM_MODEL_RERANK=<reranker, ex : bge-reranker-v2-m3>
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=3
# Réflexion du modèle : si des réponses reviennent vides ou coupées, mettre none (vide = rien envoyé)
# LLM_REASONING_EFFORT=none
# Place de réponse (tokens) pour la lecture des pages ; doublée une fois si la réponse est vide ou coupée
# LLM_MAX_TOKENS_EXTRACT=4096
# Appels IA simultanés : à augmenter si la passerelle le supporte (synchro plus rapide)
LLM_CONCURRENCY=4
# Cache des réponses IA : un passage déjà analysé à l'identique ne repart pas à l'IA
LLM_CACHE_DIR=./data/cache/llm
# false si la passerelle refuse response_format
LLM_JSON_MODE=true
# native = function calling ; json = repli si la passerelle refuse les outils (npm run doctor indique lequel)
LLM_TOOLS_MODE=native
# true = aucun appel réel (tests)
LLM_MOCK=false

# --- MCP interne (ServiceNow, Bitbucket, Jira ; pas Confluence) ---
MCP_BASE_URL=https://<passerelle-mcp>/api/mcp/tools
MCP_TOKEN=<jeton MCP>

# --- Confluence : récupération des pages (npm run fetch:confluence) ---
# URL de Confluence AVEC son chemin de contexte s'il y en a un, ex : https://<confluence> ou https://<hote>/wiki
# (c'est la partie avant /rest/api/... dans les appels de l'API)
CONFLUENCE_BASE_URL=https://<confluence>
# Authentification : jeton personnel (recommandé, Profil > Jetons d'accès personnels) ...
CONFLUENCE_TOKEN=<jeton personnel Confluence>
# ... ou identifiant + mot de passe (laisser CONFLUENCE_TOKEN vide dans ce cas)
CONFLUENCE_USER=
CONFLUENCE_PASSWORD=
# Clés des espaces à récupérer, séparées par des virgules (liste : node scripts/fetch-confluence.js --list-spaces)
CONFLUENCE_SPACES=<CLE1>,<CLE2>
# Pages téléchargées en parallèle (rester raisonnable pour ne pas charger Confluence)
CONFLUENCE_CONCURRENCY=4
CONFLUENCE_TIMEOUT_MS=60000
# Images jointes (pour l'analyse des schémas plus tard) ; les schémas draw.io sont toujours récupérés
CONFLUENCE_DOWNLOAD_IMAGES=true
# Pièces jointes plus lourdes ignorées (Mo)
CONFLUENCE_MAX_ATTACHMENT_MB=20
# Dossier où les pages sont écrites (une page = un dossier), lu ensuite par la synchro
CONFLUENCE_EXPORT_DIR=./data/raw/confluence

# --- Téléchargement automatique des exports (npm run fetch:inventory, inclus dans sync:all) ---
# Lien direct qui lance le téléchargement du CSV de la marketplace (copier l'adresse du lien dans le navigateur).
# Téléchargé au plus une fois par jour ; l'ancien fichier n'est remplacé que si le contenu a changé.
MARKETPLACE_URL=
# Si le lien demande une authentification : un jeton (Bearer) OU identifiant + mot de passe (Basic)
# OU le cookie de session copié depuis le navigateur (outils de développement > Réseau > en-tête Cookie)
MARKETPLACE_TOKEN=
MARKETPLACE_USER=
MARKETPLACE_PASSWORD=
MARKETPLACE_COOKIE=
# Même principe pour l'APM s'il a un jour un lien direct (écrit dans data/raw/apm/apm.csv)
APM_URL=

# --- Inventaires CSV (APM, marketplace) et périmètre ---
# Colonnes de chaque export (copier config/mappings.example.json)
INVENTORY_MAPPING=./config/mappings.json
# Les applications suivies (copier config/perimeter.example.json)
PERIMETER_FILE=./config/perimeter.json
# Rapports CSV pour Excel (pages par application, orthographes, contrôle des pages d'architecture)
REPORTS_DIR=./data/rapports
# Motif optionnel des noms courts de serveurs internes (regex), ex : ^[a-z]{3,5}\d{2,}[a-z0-9]*$
# (les serveurs connus des inventaires sont reconnus même sans ce motif)
HOST_SHORTNAME_PATTERN=

# --- Interface : liens et sources ---
# Boutons « Lancer » de la page Synchronisation (Confluence, APM, marketplace, tout relancer).
# Mettre false si le site est ouvert à d'autres personnes (HOST=0.0.0.0) et qu'elles ne doivent pas lancer de synchro.
ALLOW_UI_SYNC=true
# Lien du bouton « Monitoring Naemon » ({app} = nom de l'application), ex : https://naemon.interne/thruk/#cgi-bin/status.cgi?hostgroup={app}
NAEMON_URL_TEMPLATE=
# Sources branchées (affiche les compteurs au lieu de "non connecté")
SOURCE_SERVICENOW=false
SOURCE_BITBUCKET=false

# --- Lyra v2 ---
# Mode démo : jeu de données fictif généré au démarrage (aucun appel réseau, rien n'est mélangé avec DATA_DIR).
# Mettre false pour travailler sur les vraies données.
DEMO_MODE=true
# false = la v2 lit l'export Confluence (CONFLUENCE_EXPORT_DIR) sans jamais le récupérer :
# la récupération reste assurée par la v1 (cas de la reprise automatique par npm run setup)
CONFLUENCE_FETCH=true
# Nombre d'imports d'inventaire conservés dans l'historique des changements
# HISTORY_KEEP=50
# Supervision Naemon (facultatif)
# Source de l'état en direct : off (défaut), thruk (API REST), csv (export Thruk).
# NAEMON_SOURCE=off
# NAEMON_THRUK_URL=https://<naemon>/thruk
# Jeton Thruk (en-tête X-Thruk-Auth-Key) OU utilisateur et mot de passe (Basic)
# NAEMON_TOKEN=
# NAEMON_USER=
# NAEMON_PASSWORD=
# Export CSV : le bloc "naemon" de config/mappings.json décrit les colonnes (un motif * est accepté)
# NAEMON_CSV_FILE=./data/raw/naemon/hosts_*.csv
# Minutes entre deux relevés
# NAEMON_POLL_MINUTES=5
# Lien du bouton "Monitoring Naemon" ({app} = nom de l'application), ex : https://<naemon>/thruk/#cgi-bin/status.cgi?hostgroup={app}

# --- Certificat d'entreprise ---
# Si les appels HTTPS échouent avec "unable to get local issuer certificate" : définir la variable
# d'environnement SYSTÈME (pas dans ce fichier) NODE_EXTRA_CA_CERTS=<chemin du certificat racine .pem>
